+++ b/tests/reliableEventQueue.test.cjs
@@ -0,0 +1,38 @@
+const {test}=require('node:test');
+const assert=require('node:assert/strict');
+const ts=require('typescript');
+const fs=require('node:fs');
+const Module=require('node:module');
+const compiled=ts.transpileModule(fs.readFileSync('src/lib/reliableEventQueue.ts','utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText;
+const mod=new Module('queue');mod._compile(compiled,'queue.cjs');
+const {ReliableEventQueue}=mod.exports;
+function storage(){const m=new Map();return {get length(){return m.size},key:i=>[...m.keys()][i]??null,getItem:k=>m.get(k)??null,setItem:(k,v)=>m.set(k,v),removeItem:k=>m.delete(k)};}
+const idle=()=>new Promise(r=>setImmediate(r));
+const response=(status,retry=null)=>({ok:status>=200&&status<300,status,headers:{get:()=>retry}});
+const event={sessionId:'session-test',eventId:'event-test',occurredAt:'2026-11-01T10:00:00Z',siret:'83438617900024',eventType:'offer_view'};
+test('503 is retained, then retries with original SIRET/id/time after navigation',async()=>{
+ let now=Date.parse(event.occurredAt),calls=[],fail=true;const st=storage();
+ const q=new ReliableEventQueue({storage:()=>st,consent:()=>true,now:()=>now,send:async p=>{calls.push(JSON.parse(JSON.stringify(p)));return response(fail?503:204,'5')}});
+ const payload={...event};q.enqueue(payload);payload.siret='12345678901234';await idle();
+ assert.equal(st.length,1);now+=6000;fail=false;await q.flush();
+ assert.equal(st.length,0);assert.deepEqual(calls,[event,event]);q.clear();
+});
+test('reload recovers offline event from persistent storage',async()=>{
+ let now=Date.parse(event.occurredAt);const st=storage();
+ const q=new ReliableEventQueue({storage:()=>st,consent:()=>true,now:()=>now,send:async()=>{throw new Error('offline')}});
+ q.enqueue(event);await idle();const saved=st.getItem(st.key(0));q.clear();st.setItem('md_event_queue_v1:'+event.eventId,saved);
+ now+=10000;const seen=[];const reloaded=new ReliableEventQueue({storage:()=>st,consent:()=>true,now:()=>now,send:async p=>{seen.push(p);return response(204)}});
+ await reloaded.flush();assert.deepEqual(seen,[event]);assert.equal(st.length,0);reloaded.clear();
+});
+test('an intermediary HTTP 200 page does not acknowledge an event',async()=>{
+ const st=storage();const q=new ReliableEventQueue({storage:()=>st,consent:()=>true,now:()=>Date.parse(event.occurredAt),send:async()=>response(200)});
+ q.enqueue(event);await idle();assert.equal(st.length,1);q.clear();
+});
+test('withdrawal of consent clears retries and prevents new collection',async()=>{
+ const st=storage();let consent=true,calls=0;const q=new ReliableEventQueue({storage:()=>st,consent:()=>consent,now:()=>Date.parse(event.occurredAt),send:async()=>{calls++;return response(503)}});
+ q.enqueue(event);await idle();consent=false;await q.flush();assert.equal(st.length,0);assert.equal(q.enqueue(event),false);assert.equal(calls,1);
+});
+test('invalid 400 payload is not retried forever',async()=>{
+ const st=storage();const q=new ReliableEventQueue({storage:()=>st,consent:()=>true,now:()=>Date.parse(event.occurredAt),send:async()=>response(400)});
+ q.enqueue(event);await idle();assert.equal(st.length,0);q.clear();
+});
