+export interface EventEnvelope { eventId: string; sessionId: string; occurredAt: string; [key: string]: unknown }
+interface Queued { payload: EventEnvelope; attempts: number; nextAt: number }
+export interface QueueOptions {
+  storage: () => Storage | null; consent: () => boolean;
+  send: (payload: EventEnvelope, signal: AbortSignal) => Promise<{ ok: boolean; status: number; headers: { get(name: string): string | null } }>;
+  now?: () => number;
+}
+const PREFIX = 'md_event_queue_v1:';
+const TTL = 24 * 60 * 60 * 1000;
+const MAX_EVENTS = 200;
+
+// Per-event keys avoid overwriting another tab's queue. The server's unique
+// (session_id,event_id) key makes concurrent tab sends safe. Payloads never change.
+export class ReliableEventQueue {
+  private memory = new Map<string, Queued>();
+  private timer?: ReturnType<typeof setTimeout>;
+  private running = false;
+  private controller?: AbortController;
+  private now: () => number;
+  constructor(private options: QueueOptions) { this.now = options.now || Date.now; }
+  private storage() { try { return this.options.storage(); } catch { return null; } }
+  private remove(id: string) { this.memory.delete(id); try { this.storage()?.removeItem(PREFIX + id); } catch { /* memory only */ } }
+  private save(item: Queued) {
+    this.memory.set(item.payload.eventId, item);
+    try { this.storage()?.setItem(PREFIX + item.payload.eventId, JSON.stringify(item)); } catch { /* memory retry still works */ }
+  }
+  private load(): Queued[] {
+    const storage = this.storage();
+    try {
+      if (storage) for (let i = 0; i < storage.length; i++) {
+        const key = storage.key(i);
+        if (!key?.startsWith(PREFIX)) continue;
+        try {
+          const item = JSON.parse(storage.getItem(key) || 'null') as Queued;
+          if (item?.payload?.eventId && Number.isFinite(Date.parse(item.payload.occurredAt))) this.memory.set(item.payload.eventId, item);
+        } catch { /* skip malformed item */ }
+      }
+    } catch { /* blocked storage */ }
+    for (const [id, item] of this.memory) if (this.now() - Date.parse(item.payload.occurredAt) > TTL) this.remove(id);
+    return [...this.memory.values()].sort((a,b) => a.nextAt - b.nextAt);
+  }
+  enqueue(payload: EventEnvelope): boolean {
+    if (!this.options.consent()) { this.clear(); return false; }
+    const items = this.load();
+    if (items.some(x => x.payload.eventId === payload.eventId)) return true;
+    if (items.length >= MAX_EVENTS || JSON.stringify(payload).length > 24_000) return false;
+    // Deep copy once so caller changes / a later SIRET selection cannot alter retries.
+    this.save({ payload: JSON.parse(JSON.stringify(payload)), attempts: 0, nextAt: this.now() });
+    void this.flush(); return true;
+  }
+  clear() {
+    if (this.timer) clearTimeout(this.timer);
+    this.controller?.abort();
+    for (const item of this.load()) this.remove(item.payload.eventId);
+    this.memory.clear();
+  }
+  async flush(): Promise<void> {
+    if (!this.options.consent()) { this.clear(); return; }
+    if (this.running) return;
+    this.running = true;
+    if (this.timer) clearTimeout(this.timer);
+    try {
+      for (const item of this.load().filter(x => x.nextAt <= this.now())) {
+        if (!this.options.consent()) { this.clear(); break; }
+        this.controller = new AbortController();
+        const timeout = setTimeout(() => this.controller?.abort(), 20_000);
+        let retryAfter = 0;
+        try {
+          const res = await this.options.send(item.payload, this.controller.signal);
+          if (res.status === 204 || (res.status >= 400 && res.status < 500 && ![408,425,429].includes(res.status))) {
+            this.remove(item.payload.eventId); continue;
+          }
+          const delay = res.headers.get('Retry-After');
+          if (delay) retryAfter = /^\d+$/.test(delay) ? Number(delay)*1000 : Date.parse(delay)-this.now();
+        } catch { /* network error, timeout or offline: retain the original event */ }
+        finally { clearTimeout(timeout); }
+        if (!this.options.consent()) { this.remove(item.payload.eventId); continue; }
+        item.attempts++;
+        item.nextAt = this.now() + Math.max(1000, Math.min(300_000, Math.max(retryAfter || 0, Math.min(60_000,1000*2**Math.min(item.attempts,6)))));
+        this.save(item);
+      }
+    } finally {
+      this.running = false; this.controller = undefined;
+      const remaining = this.options.consent() ? this.load() : [];
+      if (remaining.length) this.timer = setTimeout(() => void this.flush(), Math.max(500,remaining[0].nextAt-this.now()));
+    }
+  }
+}
