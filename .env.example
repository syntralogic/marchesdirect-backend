# ============================================================================
# APPLICATION
# ============================================================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5000

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=procurement_platform
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRES_IN=30d
PASSWORD_SALT_ROUNDS=10

# At-rest encryption for stored secrets (MFA TOTP secrets, connector API keys).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# MFA
MFA_WINDOW=2
MFA_ISSUER=Procurement Platform

# ============================================================================
# AWS S3 (File Storage)
# ============================================================================
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=procurement-platform-files
AWS_S3_URL=https://your-bucket.s3.eu-west-1.amazonaws.com

# ============================================================================
# STRIPE (Payments)
# ============================================================================
STRIPE_PUBLIC_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_test_your_key

# ============================================================================
# ANTHROPIC / OPENAI (AI/LLM)
# ============================================================================
# Use one or both
ANTHROPIC_API_KEY=sk-ant-your_key_here
OPENAI_API_KEY=sk-your_key_here

# LLM Configuration
LLM_PROVIDER=anthropic  # 'anthropic' or 'openai'
LLM_MODEL=claude-sonnet-5
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000

# ============================================================================
# REDIS (Caching & Job Queue)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# DATA SOURCES (Connectors)
# ============================================================================

# BOAMP - real public open-data portal (Opendatasoft/DILA), no key required.
# Verified live (web search, Feb 2026 community source list): Explore API
# v2.1, 1.68M+ notices, same-day data.
# https://boamp-datadila.opendatasoft.com/api/explore/v2.1/console
BOAMP_API_ENDPOINT=https://boamp-datadila.opendatasoft.com/api/explore/v2.1/catalog/datasets/boamp/records
BOAMP_API_KEY=
BOAMP_COLLECTION_FREQUENCY_HOURS=6

# DECP consolidées - client's recommended primary source (aggregates BOAMP +
# every profil acheteur + PLACE, updated near-daily). decp.info itself has no
# API (CSV/XLSX download only) - the real data + Opendatasoft API lives on
# data.economie.gouv.fr (mirror: opendatamef.opendatasoft.com), no key
# required. Verified live (web search, Feb 2026 community source list) as
# the real working query - Explore API v2.1, dataset decp-2022-marches-valides
# (656,837 records). See the sourcing note above collectDecpData() in
# dataCollectionService.ts for what's confirmed vs. still best-effort.
# API console: https://data.economie.gouv.fr/api/explore/v2.1/console
DECP_API_ENDPOINT=https://data.economie.gouv.fr/api/explore/v2.1/catalog/datasets/decp-2022-marches-valides/records
DECP_API_KEY=

# Batiweb - one concretely open/scrapable private-tender-adjacent source the
# client identified (actualités/marchés section, no login). RSS-based, not
# HTML scraping. Same caveat as DECP: verify this feed URL is live and
# actually contains marché items before enabling in production, and check
# Batiweb's current robots.txt/CGU first - "public page" isn't automatically
# "OK to poll on a schedule".
BATIWEB_FEED_URL=https://www.batiweb.com/rss/actualites.xml

# PLACE
PLACE_API_ENDPOINT=https://api.place.gouv.fr/v1
PLACE_API_KEY=your_key_here
PLACE_COLLECTION_FREQUENCY_HOURS=6

# INSEE Sirene (SIRET company recognition - prototype V17 "reconnaissance
# d'entreprise" flow). Free API, requires an app registered at
# https://api.insee.fr to get a key. Open point: confirm with the client.
INSEE_API_KEY=your_key_here

# Pappers (https://www.pappers.fr/api) - client's explicit priority (WhatsApp,
# 31 Aug) for SIRET auto-fill, since it covers capital social, dirigeant, and
# certifications/labels (RGE, ORIAS, "Société à mission", etc. - see
# 'champs_supplementaires=labels') that INSEE Sirene doesn't have at all.
# Free tier: 10,000 fiches/month. Register an account at pappers.fr, then
# "Mon API" in the left menu for the token. Tried first when set; falls back
# to INSEE_API_KEY above if unset or if Pappers doesn't have the SIRET.
# Client also mentioned Societe.com as a further fallback - not implemented
# here since, unlike Pappers/INSEE, it has no official public API (scraping
# it would be fragile and outside what a REST integration like this one
# should rely on); flagging this back to the client rather than building
# something unreliable.
PAPPERS_API_KEY=your_key_here

# TED (EU Tenders)
TED_API_ENDPOINT=https://ted.europa.eu/api/v1
TED_COLLECTION_FREQUENCY_HOURS=12

# ============================================================================
# CRM INTEGRATION
# ============================================================================
CRM_SYSTEM=pipedrive  # 'hubspot', 'pipedrive', 'salesforce', etc.
CRM_API_KEY=your_crm_key_here
CRM_BASE_URL=https://your-crm-instance.pipedrive.com/api/v1

# ============================================================================
# EMAIL (Optional - for notifications)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@procurement-platform.fr

# ============================================================================
# BACKUP & MONITORING
# ============================================================================
BACKUP_S3_BUCKET=procurement-platform-backups
BACKUP_SCHEDULE=0 5 * * *  # 5am daily

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=debug  # debug, info, warn, error
LOG_FORMAT=json  # json or text
LOG_FILE_PATH=./logs/app.log

# ============================================================================
# FEATURES & COMPLIANCE
# ============================================================================
FEATURE_ELECTRONIC_INVOICING=false
FEATURE_SEO_GENERATION=true
FEATURE_CHATBOT=true
FEATURE_TENDER_RESPONSE_MODULE=true

# GDPR & Data Protection
DATA_RETENTION_DAYS=365
GDPR_PROCESSING_AGREEMENT=true
